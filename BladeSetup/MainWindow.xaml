<Window x:Class="BladeSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blade Setup"
        Width="800"
        Height="520"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Icon="Blade.ico"
        Loaded="Window_Loaded">

    <!-- Сдержанная винная сцена: бренд виден, но не спорит с содержимым. -->
    <Border CornerRadius="16"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Border Background="{StaticResource BrushBgWindow}" />

            <!-- Статичный рассеянный акцент: без постоянного перерисовывания фона. -->
            <Border IsHitTestVisible="False" Opacity="0.65">
                <Border.Background>
                    <RadialGradientBrush Center="0.05,0.95" GradientOrigin="0.05,0.95" RadiusX="0.9" RadiusY="0.9">
                        <GradientStop Color="#283C2026" Offset="0.0" />
                        <GradientStop Color="#14251B20" Offset="0.5" />
                        <GradientStop Color="#00100D10" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Border IsHitTestVisible="False" Opacity="0.12">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#00000000" Offset="0.65" />
                        <GradientStop Color="#66000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Небольшое число фоновых искр; основной контент остаётся спокойным. -->
            <Canvas x:Name="ParticlesCanvas"
                    IsHitTestVisible="False"
                    ClipToBounds="True" />

            <Border VerticalAlignment="Top" Height="1" Background="#59404A" IsHitTestVisible="False" />

            <!-- 4. ОСНОВНОЙ СЛОЙ ИНТЕРФЕЙСА -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ==================================================== -->
                <!-- TITLE BAR: перетаскивание разрешено только за шапку   -->
                <!-- ==================================================== -->
                <Border x:Name="TitleBar"
                        Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <!-- Текущая эмблема Blade и название установщика -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Image RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   Source="brand-logo.png"
                                   Width="18"
                                   Height="18"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="BLADE"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="Segoe UI, sans-serif"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" / SETUP"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="10"
                                       Margin="4,1,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Правая часть: кнопки управления окном -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BladeCloseButtonStyle}"
                                    Content="—"
                                    Width="36"
                                    Height="42"
                                    Click="MinimizeButton_Click"
                                    AutomationProperties.Name="Свернуть окно" />
                            <Button Style="{StaticResource BladeCloseButtonStyle}"
                                    Content="✕"
                                    Width="38"
                                    Height="42"
                                    Click="CloseButton_Click"
                                    AutomationProperties.Name="Закрыть окно" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- КОНТЕЙНЕР ЭКРАНОВ ВИЗАРДА (4 ЭКРАНА)                 -->
                <!-- ==================================================== -->
                <Grid Grid.Row="1" Margin="22,6,22,22">

                    <!-- ================================================ -->
                    <!-- ЭКРАН 1: ВЫБОР ПАПКИ УСТАНОВКИ                   -->
                    <!-- ================================================ -->
                    <Grid x:Name="ScreenSplash" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0" Y="0" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.92*" />
                            <ColumnDefinition Width="1.08*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#151115"
                                BorderBrush="#32262B"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="24"
                                Margin="0,0,18,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource BrushAccentRed}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="BROWSER EDITION"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="112" Height="112"
                                            CornerRadius="28"
                                            Background="#1C171B"
                                            BorderBrush="#3A2B30"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center">
                                        <Image Source="brand-logo.png"
                                               Width="78" Height="78"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock Text="BLADE"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,20,0,0" />
                                    <TextBlock Text="ТВОЙ БРАУЗЕР. ТВОИ ПРАВИЛА."
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="На базе Firefox"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Background="#171317"
                                        BorderBrush="#30252A"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="12,9">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="ВЕРСИЯ"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="VersionTextBlock"
                                                       Text="v…"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="ОФЛАЙН-УСТАНОВЩИК"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="9"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="8,10,6,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="ШАГ 01  /  НАСТРОЙКА"
                                           Foreground="{StaticResource BrushAccentRed}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                    <TextBlock x:Name="SetupActionTitleTextBlock"
                                               Text="Куда установить Blade?"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,0" />
                                    <TextBlock x:Name="SetupActionDescriptionTextBlock"
                                               Text="Выбери папку для файлов браузера."
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="12"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="#171317"
                                    BorderBrush="#38292E"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="17"
                                    VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="ПАПКА УСТАНОВКИ"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="9" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TargetFolderTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource BladeTextBoxStyle}"
                                                 Height="44"
                                                 TextWrapping="NoWrap"
                                                 AutomationProperties.Name="Путь к папке установки Blade" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource BladeButtonStyle}"
                                                Content="…"
                                                Padding="0"
                                                FontSize="18"
                                                Height="44"
                                                Click="BrowseFolder_Click"
                                                AutomationProperties.Name="Выбрать папку установки" />
                                    </Grid>
                                    <Border Height="1" Background="#30252A" Margin="0,17,0,15" />
                                    <CheckBox x:Name="CreateDesktopShortcutCheckBox"
                                              Style="{StaticResource BladeCheckBoxStyle}"
                                              Content="Ярлык на рабочем столе"
                                              IsChecked="True"
                                              AutomationProperties.Name="Создать ярлык на рабочем столе" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="01  НАСТРОЙКА"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="02  ЛИЦЕНЗИЯ"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               FontSize="9"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource BladeAccentButtonStyle}"
                                        Width="176"
                                        Height="46"
                                        Click="NextToLicenseButton_Click"
                                        AutomationProperties.Name="Перейти к лицензионному соглашению">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Продолжить" VerticalAlignment="Center" />
                                        <TextBlock Text="→" FontSize="17" Margin="12,-1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ScreenLicense" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0" Y="0" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.92*" />
                            <ColumnDefinition Width="1.08*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#151115"
                                BorderBrush="#32262B"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20"
                                Margin="0,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ШАГ 02  /  02 — ЛИЦЕНЗИЯ"
                                           Foreground="{StaticResource BrushAccentRed}"
                                           FontSize="9"
                                           FontWeight="SemiBold" />
                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <TextBlock Text="Без мелкого шрифта."
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Коротко о том, кто сделал Blade и что в него входит."
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,14,0,10" VerticalAlignment="Center">
                                    <Border Background="#1D171B" BorderBrush="#38292E" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="7" Background="#35252B" VerticalAlignment="Top">
                                                <TextBlock Text="01" Foreground="{StaticResource BrushAccentRed}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Blade — авторский проект" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="Код, дизайн, темы и система кастомизации — Denis Bobliksov." Foreground="{StaticResource BrushTextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Background="#1D171B" BorderBrush="#38292E" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="7" Background="#35252B" VerticalAlignment="Top">
                                                <TextBlock Text="02" Foreground="{StaticResource BrushAccentRed}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Графика — zxvolfik" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="Обложки и виджеты используются с разрешения художника и с указанием его имени." Foreground="{StaticResource BrushTextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Background="#1D171B" BorderBrush="#38292E" BorderThickness="1" CornerRadius="9" Padding="11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="7" Background="#35252B" VerticalAlignment="Top">
                                                <TextBlock Text="03" Foreground="{StaticResource BrushAccentRed}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="В основе — Mozilla Firefox" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="Для движка действует Mozilla Public License 2.0." Foreground="{StaticResource BrushTextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="3"
                                           Text="Полный текст справа — на русском и английском."
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="9"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1"
                                Background="#151115"
                                BorderBrush="#32262B"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Полный текст"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Лицензия Blade Browser"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   FontSize="10"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#21191E" BorderBrush="#38292E" BorderThickness="1" CornerRadius="7" Padding="8,4">
                                        <TextBlock Text="EN  /  RU" Foreground="{StaticResource BrushTextSecondary}" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <Border Grid.Row="1"
                                        Background="#100D10"
                                        BorderBrush="#30252A"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="8"
                                        Margin="0,12,0,0">
                                    <TextBox x:Name="LicenseTextBox"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="Transparent"
                                             Foreground="#D6CCCF"
                                             BorderThickness="0"
                                             FontFamily="Segoe UI, sans-serif"
                                             FontSize="11.5"
                                             Padding="8"
                                             CaretBrush="{StaticResource BrushAccentRed}"
                                             AutomationProperties.Name="Полный текст лицензии Blade Browser" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="AcceptLicenseCheckBox"
                                      Style="{StaticResource BladeCheckBoxStyle}"
                                      Content="Я прочитал и принимаю условия"
                                      IsChecked="False"
                                      VerticalAlignment="Center"
                                      Checked="AcceptLicenseCheckBox_Changed"
                                      Unchecked="AcceptLicenseCheckBox_Changed"
                                      AutomationProperties.Name="Принять условия лицензионного соглашения" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource BladeGhostButtonStyle}"
                                        Content="Назад"
                                        Width="96"
                                        Height="42"
                                        Margin="0,0,9,0"
                                        Click="BackToSplashButton_Click"
                                        AutomationProperties.Name="Вернуться на экран выбора пути" />
                                <Button x:Name="InstallFromLicenseButton"
                                        Style="{StaticResource BladeAccentButtonStyle}"
                                        Content="Установить Blade"
                                        Width="166"
                                        Height="42"
                                        IsEnabled="False"
                                        Opacity="0.4"
                                        Click="StartInstallButton_Click"
                                        AutomationProperties.Name="Начать установку Blade" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ScreenInstalling" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0" Y="0" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Центральная часть: эмблема Blade и текущий статус -->
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Дышащий неоновый логотип -->
                            <Grid HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="InstallLogoScale" ScaleX="1.0" ScaleY="1.0" />
                                </Grid.RenderTransform>
                                <Border Width="72" Height="72"
                                        CornerRadius="20"
                                        Background="#1C171B"
                                        BorderBrush="#3A2B30"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                </Border>
                                <Image Source="brand-logo.png"
                                       Width="56"
                                       Height="56"
                                       Opacity="0.95"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>

                            <TextBlock x:Name="InstallStageTextBlock"
                                       Text="Подготовка к установке..."
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="Segoe UI, sans-serif"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,0" />

                            <TextBlock x:Name="InstallDetailsTextBlock"
                                       Text="Проверка файлов архива..."
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontFamily="Segoe UI, sans-serif"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Чистый прогресс-трек с одним спокойным акцентом. -->
                        <Grid Grid.Row="1" Margin="20,10,20,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Контейнер трека прогрессбара -->
                            <Grid x:Name="ProgressBarTrack" Grid.Row="0" Height="7"
                                  AutomationProperties.Name="Ход установки Blade">
                                <!-- Фоновый неактивный трек -->
                                <Border Background="#1A0609" CornerRadius="2.5" />

                                <!-- Заполнение обновляется из кода установки. -->
                                <Border x:Name="ProgressBarFill"
                                        HorizontalAlignment="Stretch"
                                        RenderTransformOrigin="0,0.5"
                                        Background="{StaticResource BrushAccentRed}"
                                        CornerRadius="3">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ProgressBarScale" ScaleX="0" ScaleY="1" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <!-- Индикатор процентов -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <TextBlock x:Name="ProgressPercentTextBlock"
                                           Text="0%"
                                           Foreground="{StaticResource BrushAccentRed}"
                                           FontFamily="Segoe UI, sans-serif"
                                           FontSize="13"
                                           FontWeight="Black"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>

                        <!-- Кнопка отмены процесса -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Button x:Name="CancelInstallButton"
                                    Style="{StaticResource BladeGhostButtonStyle}"
                                    Content="Отмена"
                                    HorizontalAlignment="Center"
                                    Padding="20,6"
                                    Click="CancelInstallButton_Click"
                                    AutomationProperties.Name="Отменить процесс установки" />
                        </Grid>
                    </Grid>

                    <!-- ================================================ -->
                    <!-- ЭКРАН 4: ЗАВЕРШЕНИЕ УСТАНОВКИ                     -->
                    <!-- ================================================ -->
                    <Grid x:Name="ScreenDone" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0" Y="0" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Фирменный знак Blade. -->
                            <Grid HorizontalAlignment="Center">
                                <Border Width="88" Height="88"
                                        CornerRadius="24"
                                        Background="#1C171B"
                                        BorderBrush="#3A2B30"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                </Border>
                                <Image Source="brand-logo.png"
                                       Width="72"
                                       Height="72"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>

                            <TextBlock x:Name="DoneTitleTextBlock"
                                       Text="Blade установлен"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="Segoe UI, sans-serif"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,18,0,0" />

                            <TextBlock x:Name="DoneSummaryTextBlock"
                                       Text="Установка завершена успешно!"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="Segoe UI, sans-serif"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0" />

                            <TextBlock x:Name="DoneTargetDirectoryTextBlock"
                                       Text=""
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontFamily="Segoe UI, sans-serif"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />

                            <CheckBox x:Name="DoneDesktopShortcutCheckBox"
                                      Style="{StaticResource BladeCheckBoxStyle}"
                                      Content="Добавить ярлык на рабочий стол"
                                      IsChecked="True"
                                      HorizontalAlignment="Center"
                                      Margin="0,16,0,0"
                                      Checked="DoneDesktopShortcutCheckBox_Changed"
                                      Unchecked="DoneDesktopShortcutCheckBox_Changed"
                                      AutomationProperties.Name="Добавить ярлык на рабочий стол" />
                        </StackPanel>

                        <!-- Кнопки завершения: запуск и выход -->
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BladeAccentButtonStyle}"
                                        Content="Запустить Blade"
                                        Width="180"
                                        Height="42"
                                        Margin="0,0,12,0"
                                        Click="LaunchBladeButton_Click"
                                        AutomationProperties.Name="Запустить браузер Blade" />

                                <Button Style="{StaticResource BladeGhostButtonStyle}"
                                        Content="Закрыть"
                                        Width="120"
                                        Height="42"
                                        Click="ExitButton_Click"
                                        AutomationProperties.Name="Выйти из мастера установки" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Grid>

                <!-- ==================================================== -->
                <!-- МОДАЛЬНЫЙ ДИАЛОГ ВНУТРИ ОКНА (ERROR / CONFIRMATION)   -->
                <!-- ==================================================== -->
                <Grid x:Name="ModalDialogOverlay"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      Background="#E6040001"
                      Visibility="Collapsed">
                    <Border Width="460"
                            Background="{StaticResource BrushCardBg}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.9" ShadowDepth="4" />
                        </Border.Effect>
                        <StackPanel>
                            <!-- Заголовок модального окна -->
                            <TextBlock x:Name="ModalDialogTitle"
                                       Text="Сообщение"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="Segoe UI, sans-serif"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8">
                            </TextBlock>

                            <!-- Текст сообщения модального окна -->
                            <TextBlock x:Name="ModalDialogMessage"
                                       Text=""
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="Segoe UI, sans-serif"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,0,0,18" />

                            <!-- Кнопки управления модальным окном -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ModalSecondaryButton"
                                        Style="{StaticResource BladeGhostButtonStyle}"
                                        Content="Отмена"
                                        Width="110"
                                        Height="36"
                                        Margin="0,0,10,0"
                                        Click="ModalSecondaryButton_Click"
                                        AutomationProperties.Name="Отменить действие диалога" />

                                <Button x:Name="ModalPrimaryButton"
                                        Style="{StaticResource BladeAccentButtonStyle}"
                                        Content="ОК"
                                        Width="120"
                                        Height="36"
                                        Click="ModalPrimaryButton_Click"
                                        AutomationProperties.Name="Подтвердить действие диалога" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- Ненавязчивый цветовой отклик после завершения. -->
            <Border x:Name="FlashOverlay"
                    Background="#D94B59"
                    Opacity="0"
                    IsHitTestVisible="False" />

        </Grid>
    </Border>
</Window>
